# Copy to .env and fill in real values. Lists every env var the app /
# docker-compose use.
URL=localhost:5000

# In Docker Compose, MYSQL_HOST is the db service name (mysql); for a local
# (non-Docker) run against a local MySQL it would be localhost.
MYSQL_HOST=mysql
MYSQL_USER=myportfolio
MYSQL_PASSWORD=mypassword
MYSQL_DATABASE=myportfoliodb
MYSQL_ROOT_PASSWORD=my-root-password

# Set TESTING=true only when running the test suite (switches to in-memory SQLite).
# TESTING=true
